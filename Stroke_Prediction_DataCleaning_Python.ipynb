from IPython.display import Markdown, display
from datetime import datetime
import matplotlib.pyplot as plt
import pandas as pd
import seaborn as sns

sns.set_theme(style="whitegrid")

student_id = "samris1626"
todays_date = datetime.now().strftime("%Y-%m-%d")

display(Markdown(f"### {student_id} - {todays_date}"))

file_path = r"C:\Files\Excel\Project\Stroke_Prediction_Dataset.xlsx"
df = pd.read_excel(file_path)

df.columns = df.columns.str.strip()


## HISTOGRAM
plt.figure(figsize=(8, 5))
sns.histplot(df["Age"], kde=True, bins=20, color="skyblue")
plt.title("Age Distribution of Patients", fontsize=14, fontweight="bold")
plt.xlabel("Age", fontsize=12)
plt.ylabel("Patient Count", fontsize=12)
plt.tight_layout()
plt.show()


stroke_patients = df[
    df["Diagnosis"].astype(str).str.contains("Stroke", case=False, na=False)
    | (df["Diagnosis"] == 1)
]


## BAR CHART
plt.figure(figsize=(8, 5))
work_type_counts = stroke_patients["Work Type"].value_counts()
sns.barplot(
    x=work_type_counts.index, y=work_type_counts.values, palette="viridis"
)
plt.title(
    "Work Type Distribution (Stroke Patients)", fontsize=14, fontweight="bold"
)
plt.xlabel("Work Type", fontsize=12)
plt.ylabel("Count", fontsize=12)
plt.xticks(rotation=15)
plt.tight_layout()
plt.show()


## SCATTERPLOT
plt.figure(figsize=(8, 5))
sns.scatterplot(
    data=stroke_patients,
    x="Age",
    y="Body Mass Index (BMI)",
    alpha=0.7,
    color="coral",
    s=60,
)
plt.title(
    "Age vs. Body Mass Index (BMI) (Stroke Patients)",
    fontsize=14,
    fontweight="bold",
)
plt.xlabel("Age", fontsize=12)
plt.ylabel("Body Mass Index (BMI)", fontsize=12)
plt.tight_layout()
plt.show()


## HEATMAP
numerical_cols = ["Age", "Body Mass Index (BMI)", "Average Glucose Level"]
corr_matrix = df[numerical_cols].corr()

plt.figure(figsize=(7, 5))
sns.heatmap(corr_matrix, annot=True, cmap="coolwarm", fmt=".2f", vmin=-1, vmax=1)
plt.title("Correlation Heatmap", fontsize=14, fontweight="bold")
plt.tight_layout()
plt.show()
